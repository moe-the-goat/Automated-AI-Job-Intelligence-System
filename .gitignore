__pycache__/
*.py[cod]
*$py.class
*.csv
.env
# Tracker state is persisted via GitHub Actions cache, not via git.
seen_jobs.json
# CV embedding cache — regenerated per run if not present.
data/cv_embedding.json
# Future per-user feedback file (Fix 11) — never commit.
data/feedback.json
# ATS detection cache (Greenhouse/Lever/Workable tokens). Re-detected after 30d.
data/ats_cache.json
# Rolling 14-day embedding history for semantic dedup. Regenerates from the
# Actions cache (alongside seen_jobs.json) — never commit.
data/embedding_history.json
# Local-only working files — never push to GitHub.
CLAUDE.md
CHAT_HISTORY.md
# CV text is stored as a GitHub Actions secret (CV_TEXT) and written at runtime.
cv_text.txt
# Claude Code editor state — local only.
.claude/

# pytest cache — local artifact, regenerated each run.
.pytest_cache/
feedback_log.json
